{
  "name": "portfolio",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "check": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro check",
    "check:numeros": "node scripts/check-numeros.mjs",
    "check:conf": "bash scripts/check-confidencialidade.sh",
    "verificar": "npm run check && npm run build && npm run check:numeros && npm run check:conf"
  },
  "dependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/mdx": "8.1.2",
    "@fontsource-variable/source-sans-3": "5.2.8",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "astro": "7.4.4",
    "cross-env": "7.0.3",
    "typescript": "6.0.3"
  }
}
