---
import BaseLayout from './BaseLayout.astro';
import Tag from '../components/Tag.astro';
import StackChips from '../components/StackChips.astro';
import CaseNav from '../components/CaseNav.astro';
import { ehRascunho, type CaseEntry } from '../lib/cases';
import { caminho, idiomaDe, t } from '../lib/i18n';

interface Props {
  entry: CaseEntry;
  anterior?: CaseEntry;
  proximo?: CaseEntry;
}

const { entry, anterior, proximo } = Astro.props;
const d = entry.data;
const curto = d.formato === 'case curto';
const rascunho = ehRascunho(entry);
const idioma = idiomaDe(Astro.url);
const tx = t(idioma);

const links = [
  d.links?.arxiv && { href: d.links.arxiv, rotulo: 'Paper (arXiv)' },
  d.links?.paper && { href: d.links.paper, rotulo: 'Paper' },
  d.links?.codigo && { href: d.links.codigo, rotulo: tx.linkCodigo },
].filter(Boolean) as { href: string; rotulo: string }[];
---
<BaseLayout titulo={d.titulo} descricao={d.resumo}>
  <article class="case container">
    {rascunho && (
      <p class="rascunho" role="note">
        {tx.rascunhoAviso(d.status_publicacao)}
      </p>
    )}

    <header class="cabecalho">
      <a class="text-link voltar" href={caminho(idioma, '/#projects')}><span aria-hidden="true">←</span> {tx.todosProjetos}</a>
      <h1>{d.titulo}</h1>
      {!curto && d.frase_destaque && <p class="lead heroi">{d.frase_destaque}</p>}
    </header>

    <div class="corpo">
      <aside class="ficha" aria-label={tx.fichaRotulo}>
        <dl>
          <div><dt class="kicker">{tx.fOrganizacao}</dt><dd>{d.organizacao}</dd></div>
          <div><dt class="kicker">{tx.fPapel}</dt><dd>{d.papel}</dd></div>
          <div><dt class="kicker">{tx.fPeriodo}</dt><dd>{d.periodo}</dd></div>
          {d.links?.venue && <div><dt class="kicker">{tx.fVenue}</dt><dd>{d.links.venue}</dd></div>}
          {links.length > 0 && (
            <div>
              <dt class="kicker">{tx.fLinks}</dt>
              <dd>
                <ul class="links">
                  {links.map((l) => <li><a class="text-link" href={l.href} rel="noopener">{l.rotulo} <span aria-hidden="true">↗</span></a></li>)}
                </ul>
              </dd>
            </div>
          )}
          <div>
            <dt class="kicker">{tx.fCamadas}</dt>
            <dd>
              <ul class="tags">
                {d.camadas.map((c) => <li><Tag camada={c} /></li>)}
              </ul>
            </dd>
          </div>
          <div>
            <dt class="kicker">{tx.fStack}</dt>
            <dd><StackChips itens={d.stack} /></dd>
          </div>
        </dl>
      </aside>

      <div class="prose">
        <slot />
      </div>
    </div>

    <CaseNav anterior={anterior} proximo={proximo} />
  </article>
</BaseLayout>

<style>
  .case {
    padding-block: clamp(2rem, 5vw, 4rem) var(--section-pad);
  }
  .rascunho {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    border: 1px dashed var(--fg-muted);
    padding: var(--space-2) var(--space-3);
    margin-block-end: var(--space-5);
  }

  .cabecalho {
    padding-bottom: clamp(2rem, 5vw, 4rem);
    border-bottom: 1px solid var(--rule);
  }
  .voltar {
    margin-bottom: clamp(1.5rem, 4vw, 3rem);
    color: var(--fg-muted);
  }
  .cabecalho h1 {
    max-width: 22ch;
    font-size: clamp(2.4rem, 5.6vw, 5rem);
    line-height: 1;
    margin: 0;
  }
  .heroi {
    max-width: 46rem;
    margin: var(--space-4) 0 0;
    font-variant-numeric: tabular-nums lining-nums;
  }

  /* Duas colunas, como os cabeçalhos de seção da home: ficha à esquerda, texto à direita. */
  .corpo {
    display: grid;
    grid-template-columns: minmax(200px, 0.35fr) minmax(0, 1.65fr);
    gap: clamp(2rem, 5vw, 5rem);
    padding-top: clamp(2rem, 4vw, 3.5rem);
  }
  .ficha dl {
    position: sticky;
    top: calc(var(--header-h) + 1.5rem);
    display: grid;
    gap: var(--space-4);
    margin: 0;
  }
  .ficha dt {
    margin-bottom: var(--space-1);
  }
  .ficha dd {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.45;
  }
  .tags,
  .links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .links {
    flex-direction: column;
    gap: 0;
  }
  .links .text-link {
    min-height: 32px;
  }

  .prose {
    min-width: 0;
    max-width: 48rem;
  }
  /* O primeiro título do corpo encosta no topo da coluna, sem fio extra. */
  .prose > :global(h2:first-child) {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }

  @media (max-width: 900px) {
    .corpo {
      grid-template-columns: 1fr;
    }
    .ficha dl {
      position: static;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
      padding-bottom: var(--space-4);
      border-bottom: 1px solid var(--rule);
    }
  }
</style>
