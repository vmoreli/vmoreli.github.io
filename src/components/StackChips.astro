---
import Chip from './Chip.astro';

interface Props {
  itens: string[];
}

const { itens } = Astro.props;
---

<ul class="stack" aria-label="Stack">
  {
    itens.map((item) => (
      <li>
        <Chip>{item}</Chip>
      </li>
    ))
  }
</ul>

<style>
  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }
</style>
