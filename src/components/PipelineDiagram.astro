---
// Diagrama de pipeline: caixas e setas, sem JS. Lista ordenada semântica;
// horizontal (com quebra) no desktop, vertical abaixo de 640px.
interface Props {
  etapas: string[];
  rotulo: string;
}

const { etapas, rotulo } = Astro.props;
---

<figure class="pipeline">
  <ol aria-label={rotulo}>
    {
      etapas.map((etapa, i) => (
        <li>
          <span class="caixa">
            <span class="n" aria-hidden="true">
              {i + 1}
            </span>
            <span class="texto">{etapa}</span>
          </span>
          {i < etapas.length - 1 && (
            <svg class="seta" viewBox="0 0 24 12" aria-hidden="true" focusable="false">
              <path d="M0 6 H20 M15 1 L21 6 L15 11" />
            </svg>
          )}
        </li>
      ))
    }
  </ol>
  <figcaption>{rotulo}</figcaption>
</figure>

<style>
  .pipeline {
    margin: var(--space-4) 0;
  }
  ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .caixa {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
    font-family: var(--font-sans);
    font-size: 0.875rem;
    line-height: 1.35;
    color: var(--fg);
    background: var(--bg-subtle);
    border: 1px solid var(--fg);
    padding: var(--space-2) var(--space-3);
    max-width: 16rem;
  }
  .n {
    font-variant-numeric: tabular-nums;
    font-weight: 700;
    font-size: 0.75rem;
    padding: 0 0.3em;
    background: var(--accent);
    color: var(--on-accent);
  }
  .seta {
    flex: none;
    width: 1.5rem;
    height: 0.75rem;
  }
  .seta path {
    fill: none;
    stroke: var(--fg-muted);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  figcaption {
    margin-top: var(--space-2);
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--fg-muted);
  }
  @media (max-width: 640px) {
    ol {
      flex-direction: column;
      align-items: stretch;
    }
    li {
      flex-direction: column;
      align-items: stretch;
    }
    .caixa {
      max-width: none;
    }
    .seta {
      align-self: center;
      transform: rotate(90deg);
      margin: var(--space-1) 0;
    }
  }
</style>
