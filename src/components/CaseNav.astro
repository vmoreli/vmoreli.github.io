---
import { slugDe, type CaseEntry } from '../lib/cases';
import { caminho, idiomaDe, t } from '../lib/i18n';

interface Props {
  anterior?: CaseEntry;
  proximo?: CaseEntry;
}

const { anterior, proximo } = Astro.props;
const idioma = idiomaDe(Astro.url);
const tx = t(idioma);
const link = (e: CaseEntry) => caminho(idioma, `/cases/${slugDe(e)}/`);
---
{(anterior || proximo) && (
  <nav class="case-nav" aria-label={tx.maisCases}>
    {anterior && (
      <a class="anterior" href={link(anterior)} rel="prev">
        <span class="dir">{tx.caseAnterior}</span>
        <span class="titulo">{anterior.data.titulo}</span>
      </a>
    )}
    {proximo && (
      <a class="proximo" href={link(proximo)} rel="next">
        <span class="dir">{tx.proximoCase}</span>
        <span class="titulo">{proximo.data.titulo}</span>
      </a>
    )}
  </nav>
)}

<style>
  .case-nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-block-start: var(--space-6);
    border-top: 1px solid var(--rule);
    border-left: 1px solid var(--rule);
  }
  a {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: clamp(1.25rem, 3vw, 2.25rem);
    border-right: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
    color: var(--fg);
    transition: background-color 0.15s ease;
  }
  a:hover {
    background: var(--bg-subtle);
  }
  a:focus-visible {
    outline-offset: -4px;
  }
  .proximo {
    grid-column: 2;
    text-align: right;
  }
  .dir {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }
  .titulo {
    font-family: var(--font-serif);
    font-size: clamp(1.15rem, 2vw, 1.5rem);
    line-height: 1.25;
    letter-spacing: -0.015em;
  }
  @media (max-width: 640px) {
    .case-nav {
      grid-template-columns: 1fr;
    }
    .proximo {
      grid-column: auto;
      text-align: left;
    }
  }
</style>
