---
// Envolve uma tabela markdown/MDX: rolagem horizontal no celular,
// focável por teclado e nomeada para leitores de tela.
interface Props {
  rotulo: string;
}

const { rotulo } = Astro.props;
---

<div class="tabela" role="region" aria-label={rotulo} tabindex="0">
  <slot />
</div>

<style>
  .tabela {
    overflow-x: auto;
    margin: var(--space-4) 0;
    border-top: 2px solid var(--fg);
    border-bottom: 1px solid var(--rule);
  }
  .tabela :global(table) {
    width: 100%;
    min-width: 32rem;
    border-collapse: collapse;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-variant-numeric: tabular-nums lining-nums;
    margin: 0;
  }
  .tabela :global(th),
  .tabela :global(td) {
    padding: 0.7rem var(--space-3);
    border-bottom: 1px solid var(--rule);
    text-align: left;
    vertical-align: top;
    color: var(--fg-muted);
  }
  .tabela :global(th) {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    vertical-align: bottom;
    color: var(--fg);
    white-space: nowrap;
  }
  .tabela :global(tr:last-child td) {
    border-bottom: 0;
  }
  /* Colunas numéricas (todas exceto a primeira) alinhadas à direita. */
  .tabela :global(th:not(:first-child)),
  .tabela :global(td:not(:first-child)) {
    text-align: right;
    white-space: nowrap;
  }
  .tabela :global(td:first-child) {
    color: var(--fg);
  }
  .tabela :global(th:first-child),
  .tabela :global(td:first-child) {
    padding-left: 0;
  }
  .tabela :global(strong) {
    font-weight: 700;
    color: var(--accent);
  }
</style>
