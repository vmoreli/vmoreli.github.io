---
// Página de erro única, nos dois idiomas (o GitHub Pages serve um só 404.html).
import BaseLayout from '../layouts/BaseLayout.astro';
import { caminho } from '../lib/i18n';
---
<BaseLayout titulo="Page not found · Página não encontrada">
  <section class="container">
    <p class="kicker">Not found · Não encontrada</p>
    <h1>Page not found.</h1>
    <p class="lead">This address does not exist or has moved.</p>
    <p class="lead" lang="pt-BR">Este endereço não existe ou mudou.</p>
    <ul class="links">
      <li><a class="text-link" href={caminho('en', '/')}>Back to home <span aria-hidden="true">→</span></a></li>
      <li><a class="text-link" href={caminho('pt', '/')} lang="pt-BR">Voltar ao início <span aria-hidden="true">→</span></a></li>
    </ul>
  </section>
</BaseLayout>

<style>
  section { padding-block: var(--section-pad); }
  .kicker { margin-bottom: var(--space-4); }
  h1 { margin-bottom: var(--space-4); }
  .lead { margin-bottom: var(--space-2); }
  .links {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-4);
    margin: var(--space-4) 0 0;
    padding: 0;
  }
</style>
